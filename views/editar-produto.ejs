<%- include('partials/head', { titulo: 'Editar produto' }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { usuario, ativo: 'produtos' }) %>
  <main class="main-content"><header class="topbar"><div class="breadcrumb"><a href="/produtos">PRODUTOS</a> <span>/</span> <strong>Editar produto</strong></div><div class="topbar-right"><span class="status-dot"></span> Sistema conectado</div></header>
    <section class="page-content form-page"><div class="page-heading"><div><div class="eyebrow eyebrow-dark">CATÁLOGO · CÓDIGO #<%= String(produto.id).padStart(4, '0') %></div><h1>Editar produto</h1><p>Atualize as informações deste item do catálogo.</p></div></div>
      <section class="panel editor-panel"><div class="editor-title"><div class="editor-icon editor-icon-edit"><svg viewBox="0 0 24 24"><path d="m14 6 4 4M4 20l4.5-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.5 16 4 20Z"/></svg></div><div><h2>Informações do produto</h2><p>Os campos marcados com <span class="required-star">*</span> são obrigatórios.</p></div></div>
        <%- include('partials/flash', { erro }) %>
        <form action="/produtos/editar/<%= produto.id %>" method="POST" class="form-stack editor-form"><div class="field-group"><label for="nome_produto">Nome do produto <span class="required-star">*</span></label><input class="text-input" id="nome_produto" name="nome_produto" maxlength="100" value="<%= produto.nome_produto %>" required autofocus><small class="field-help">Use um nome fácil de reconhecer no catálogo.</small></div>
          <div class="field-row"><div class="field-group"><label for="peso">Peso <span class="required-star">*</span></label><div class="unit-input"><input id="peso" name="peso" type="number" min="0" step="0.01" value="<%= produto.peso %>" required><span>kg</span></div><small class="field-help">Informe o peso em quilogramas.</small></div><div class="field-group"><label for="preco">Preço <span class="required-star">*</span></label><div class="unit-input currency-input"><span>R$</span><input id="preco" name="preco" type="number" min="0" step="0.01" value="<%= produto.preco %>" required></div><small class="field-help">Valor de venda em reais.</small></div></div>
          <div class="form-actions"><a class="button button-quiet" href="/produtos">Cancelar</a><button class="button button-primary" type="submit">Salvar alterações <span>→</span></button></div></form>
      </section><footer class="page-footer">BONETTOCENTER</footer>
    </section>
  </main>
</div>
</body>
</html>
