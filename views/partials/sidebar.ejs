<aside class="sidebar">
  <a class="brand" href="/produtos" aria-label="Bonettocenter, início">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M9.25 7.25h7.1a5.15 5.15 0 0 1 3.49 8.94A5.35 5.35 0 0 1 17 25H9.25V7.25Zm4 3.5v4h3a2 2 0 1 0 0-4h-3Zm0 7.4v3.35h3.4a1.68 1.68 0 0 0 0-3.35h-3.4Z" fill="currentColor" stroke="none"/></svg>
    </span>
    <span class="brand-name">Bonetto<span>center</span><small>GESTÃO DE PRODUTOS</small></span>
  </a>

  <div class="sidebar-section-label">ESPAÇO DE TRABALHO</div>
  <nav class="main-nav" aria-label="Navegação principal">
    <a class="nav-item <%= ativo === 'produtos' ? 'is-active' : '' %>" href="/produtos">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1.4"/><rect x="14" y="4" width="6" height="6" rx="1.4"/><rect x="4" y="14" width="6" height="6" rx="1.4"/><rect x="14" y="14" width="6" height="6" rx="1.4"/></svg>
      <span>Produtos</span><span class="nav-arrow">›</span>
    </a>
  </nav>

  <div class="sidebar-note">
    <span class="note-spark">✳</span>
    <strong>Organização em dia</strong>
    <p>Seus produtos em um só lugar, sempre que precisar.</p>
  </div>

  <div class="sidebar-bottom">
    <div class="profile-avatar"><%= (usuario.nome || 'U').slice(0, 1).toUpperCase() %></div>
    <div class="profile-copy"><strong><%= usuario.nome %></strong><span>Administrador</span></div>
    <form action="/logout" method="POST" class="logout-form">
      <button class="icon-button logout-button" type="submit" aria-label="Sair da conta" title="Sair">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5.8A1.8 1.8 0 0 0 4 6.8v10.4A1.8 1.8 0 0 0 5.8 19H10M14 16l4-4-4-4m4 4H9"/></svg>
      </button>
    </form>
  </div>
</aside>
