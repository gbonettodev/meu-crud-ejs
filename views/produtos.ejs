<%- include('partials/head', { titulo: 'Produtos' }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { usuario, ativo: 'produtos' }) %>
  <main class="main-content">
    <header class="topbar"><div class="breadcrumb">ESPAÇO DE TRABALHO <span>/</span> <strong>Produtos</strong></div><div class="topbar-right"><span class="status-dot"></span> Sistema conectado</div></header>
    <section class="page-content">
      <div class="page-heading">
        <div><div class="eyebrow eyebrow-dark">CATÁLOGO</div><h1>Seus produtos</h1><p>Visualize e organize os itens do seu catálogo.</p></div>
        <a class="button button-primary" href="/produtos/novo"><span class="plus">+</span> Novo produto</a>
      </div>
      <%- include('partials/flash', { erro }) %>
      <section class="stats-grid" aria-label="Resumo do catálogo">
        <article class="stat-card"><div class="stat-icon stat-icon-mint"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.8 7.5 4.4 7.5-4.4M12 12.2V21"/></svg></div><div><span class="stat-label">ITENS NO CATÁLOGO</span><strong><%= produtos.length %></strong><small><%= produtos.length === 1 ? 'produto listado' : 'produtos listados' %></small></div></article>
        <article class="stat-card stat-card-note"><div class="stat-icon stat-icon-lilac"><svg viewBox="0 0 24 24"><path d="M4 7.5h16M4 12h16M4 16.5h10"/><circle cx="18" cy="16.5" r="2.5"/></svg></div><div><span class="stat-label">DICA RÁPIDA</span><strong class="stat-message">Tudo organizado</strong><small>Use a busca para encontrar um item.</small></div></article>
      </section>
      <section class="panel product-panel">
        <div class="panel-heading"><div><h2>Lista de produtos</h2><p>Confira os detalhes e mantenha seu catálogo atualizado.</p></div><form action="/produtos" method="GET" class="search-form"><div class="search-input"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><input type="search" name="busca" value="<%= busca %>" placeholder="Buscar produto..." aria-label="Buscar produto"></div><button class="button button-search" type="submit">Buscar</button><% if (busca) { %><a class="clear-search" href="/produtos">Limpar</a><% } %></form></div>
        <div class="table-wrap"><table><thead><tr><th>PRODUTO</th><th>PESO</th><th>PREÇO</th><th class="actions-heading">AÇÕES</th></tr></thead><tbody>
          <% if (produtos.length === 0) { %><tr><td colspan="4"><div class="empty-state"><div class="empty-icon"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M8.5 12h7"/></svg></div><strong><%= busca ? 'Nenhum resultado encontrado' : 'Seu catálogo está começando' %></strong><p><%= busca ? 'Tente outro nome ou limpe o filtro.' : 'Cadastre seu primeiro produto para começar.' %></p><% if (!busca) { %><a href="/produtos/novo" class="text-link">Cadastrar produto <span>→</span></a><% } %></div></td></tr>
          <% } else { produtos.forEach((produto) => { %>
            <tr><td><div class="product-cell"><span class="product-avatar"><%= produto.nome_produto.slice(0, 1).toUpperCase() %></span><div><strong><%= produto.nome_produto %></strong><small>Código #<%= String(produto.id).padStart(4, '0') %></small></div></div></td><td><span class="table-value"><%= Number(produto.peso).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> <span>kg</span></span></td><td><span class="price-value">R$ <%= Number(produto.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span></td><td><div class="row-actions"><a class="icon-button edit-action" href="/produtos/editar/<%= produto.id %>" aria-label="Editar <%= produto.nome_produto %>" title="Editar"><svg viewBox="0 0 24 24"><path d="m14 6 4 4M4 20l4.5-1 10.8-10.8a2.1 2.1 0 0 0-3-3L5.5 16 4 20Z"/></svg></a><form action="/produtos/deletar/<%= produto.id %>" method="POST" onsubmit="return confirm('Deseja excluir este produto?')"><button class="icon-button delete-action" type="submit" aria-label="Excluir <%= produto.nome_produto %>" title="Excluir"><svg viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M6.5 7l.8 13h9.4l.8-13M9 7V4h6v3"/></svg></button></form></div></td></tr>
          <% }); } %>
        </tbody></table></div>
        <div class="table-footer"><span>Exibindo <strong><%= produtos.length %></strong> <%= produtos.length === 1 ? 'produto' : 'produtos' %><%= busca ? ` para “${busca}”` : '' %></span><span class="footer-mark"><i></i> Dados atualizados</span></div>
      </section>
      <footer class="page-footer">BONETTOCENTER</footer>
    </section>
  </main>
</div>
</body>
</html>
